<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Haptics (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Daily reminder (ADR 0021): local notifications; inexact alarms need no SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- No advertising ID (ADR 0023): Firebase Analytics brings these in; revisit when AdMob ships. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!-- TextToSpeech engine discovery (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lexi">
        <!-- Portrait-only phone app; configChanges keep the game's activity (and its clock) alive on resizes and
             dark-mode toggles instead of recreating it (ADR 0019). -->
        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:name=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase (ADR 0023, docs/ANALYTICS.md): collection follows the build type (telemetryEnabled); no ad ID,
             Consent Mode defaults deny every ad purpose, analytics storage only. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${telemetryEnabled}" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${telemetryEnabled}" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="true" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- Reminder receivers are declared in core:platform's manifest and merged in (ADR 0021). -->

        <!-- Share card: exposes only cache/share/ to the chooser target (ADR 0020). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>