<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground, option 1 of 13-logo-and-icon at home-screen size (no leaf): the yellow circle with its 5px
  ink border and the "L" (Jost ExtraBold 64px, outline from the font, centered like the CSS line box).
  Path data is in the design's 180px units; the group maps them onto the 72dp visible area (scale 0.4, offset 18), so
  the circle is 40dp wide, well inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.4"
        android:scaleY="0.4"
        android:translateX="18"
        android:translateY="18">
        <path
            android:fillColor="@color/launcher_ink"
            android:pathData="M40,90a50,50 0,1 0,100 0a50,50 0,1 0,-100 0z" />
        <path
            android:fillColor="@color/launcher_yellow"
            android:pathData="M45,90a45,45 0,1 0,90 0a45,45 0,1 0,-90 0z" />
        <path
            android:fillColor="@color/launcher_ink"
            android:pathData="M76.976,67.2V112H107.504V101.44H89.392V67.2Z" />
    </group>
</vector>
