<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on API 31+ (android:dataExtractionRules). Only excludes, so everything else is backed
     up as before. The notification-permission bookkeeping describes this device's permission dialog; restored on a new
     phone it would report the reminder permission as blocked there. Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lexi_notification_permission.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lexi_notification_permission.xml" />
    </device-transfer>
</data-extraction-rules>
