-- Joker inventory per JokerType name (GAME_RULES.md §7).
CREATE TABLE joker(
    type TEXT NOT NULL PRIMARY KEY,
    count INTEGER NOT NULL CHECK(count >= 0)
);

-- Gift bookkeeping (GAME_RULES.md §7, schema v2): per JokerGrantReason name, the epoch day it was last given for
-- (daily gift: the local day; streak bonus: the day the milestone was reached). Pro refill (M7) adds its own kind.
CREATE TABLE joker_grant(
    kind TEXT NOT NULL PRIMARY KEY,
    epoch_day INTEGER NOT NULL
);

selectAll:
SELECT * FROM joker ORDER BY type;

rowCount:
SELECT count(*) FROM joker;

setCount:
INSERT OR REPLACE INTO joker(type, count) VALUES (?, ?);

-- No UPSERT: Android 8 (minSdk 26) ships SQLite 3.18.
ensureRow:
INSERT OR IGNORE INTO joker(type, count) VALUES (?, 0);

addCount:
UPDATE joker SET count = count + :amount WHERE type = :type;

grantDays:
SELECT kind, epoch_day FROM joker_grant;

setGrantDay:
INSERT OR REPLACE INTO joker_grant(kind, epoch_day) VALUES (?, ?);
