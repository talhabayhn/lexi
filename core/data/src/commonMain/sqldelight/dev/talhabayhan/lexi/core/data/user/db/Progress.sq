-- user.db (docs/CONTENT.md §8). Schema v1; every later change is a numbered migration in
-- src/commonMain/sqldelight/migrations (<from-version>.sqm) plus a schema snapshot in
-- src/jvmTest/resources/user-db (UserDatabaseMigrationTest). Never drop user data on content changes.

-- Learning progress per card (CardProgress, GAME_RULES.md §10). card_id is a content slug; rows of cards that
-- left content.db are kept and hidden by the repository.
CREATE TABLE progress(
    card_id TEXT NOT NULL PRIMARY KEY,
    -- Leitner box 0-4; NULL = not in the notebook (never missed).
    box INTEGER,
    due_epoch_day INTEGER,
    seen INTEGER NOT NULL DEFAULT 0,
    correct INTEGER NOT NULL DEFAULT 0,
    wrong INTEGER NOT NULL DEFAULT 0,
    last_seen_ms INTEGER,
    mastered INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM progress ORDER BY card_id;

selectByIds:
SELECT * FROM progress WHERE card_id IN ? ORDER BY card_id;

lastSeen:
SELECT card_id, last_seen_ms FROM progress WHERE last_seen_ms IS NOT NULL;

upsert:
INSERT OR REPLACE INTO progress(card_id, box, due_epoch_day, seen, correct, wrong, last_seen_ms, mastered)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);
